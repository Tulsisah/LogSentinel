# ========================================================
# Git Ignore: Backend (FastAPI / Python)
# ========================================================

# Environment Variables & Secrets
.env
.env.*
*.env
!.env.example

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
.venv/
env/
ENV/

# Database Files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal
analyzer.db

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs
*.log
logs/

# IDE & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
