# Dependencies
node_modules/

# Production build artifacts
dist/
dist-ssr/

# Environment files
.env
.env.*
*.env
!.env.example
*.local

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
