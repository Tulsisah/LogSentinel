# ========================================================
# AI-Based Log Analyzer & SOC Security Platform
# Production Environment Variables Template
# ========================================================

# --- Backend Configuration ---
# Server Port (Default is 8000)
PORT=8000

# Secret key used for signing JWT analyst tokens
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_hex_string_in_production

# Database Connection URL
# SQLite default (local file):
# DATABASE_URL=sqlite:///./analyzer.db
# PostgreSQL (Production e.g. Supabase / Neon / Render / Railway):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# CORS Allowed Origins (Comma-separated URLs of allowed frontends)
# Leave empty for local development defaults, or set to your frontend domain in production
# Example: ALLOWED_ORIGINS=https://my-soc-analyzer.vercel.app,https://soc.company.com
ALLOWED_ORIGINS=

# --- Frontend Configuration ---
# (Only needed if deploying frontend separately, e.g. on Vercel or Netlify)
# Set this in your frontend hosting environment to your deployed backend URL + /api:
# Example: VITE_API_URL=https://my-backend-service.onrender.com/api
VITE_API_URL=
